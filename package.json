{
  "name": "kyros",
  "private": true,
  "type": "module",
  "workspaces": [
    "pwa"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "prebuild": "tsx scripts/generate-wiki.ts",
    "build": "npm run build -w pwa",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "tsx scripts/db-apply.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.9.3",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
