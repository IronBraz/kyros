# Kyros — Local configuration
# Copy this file to `.env.local` and fill in your real values.
# Every `.env*` except this file is gitignored; never commit real values.
#
# On Vercel these live in the project's Environment Variables, NOT in a file.
# `DATABASE_URL` and `CRON_SECRET` are injected by Vercel itself and must not be set by hand.

# === Database (server) ===
# Injected automatically by the Neon marketplace integration on Vercel.
# Set it locally only to point the db:apply / db:seed / smoke scripts at a database.
# Use the POOLED connection string (the one with "-pooler" in the host).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/kyros?sslmode=require

# === Admin session signing (server) ===
# HMAC key for admin session tokens and for hashing IPs in the rate limiter.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every logged-in Control Room session. That is the intended
# emergency lever if a token ever leaks.
KYROS_SESSION_SECRET=

# === AI concierge (server) ===
# OpenRouter API key. In the n8n stack this lived in an encrypted n8n credential.
OPENROUTER_API_KEY=
# Optional. Defaults to anthropic/claude-haiku-4-5.
KYROS_AI_MODEL=anthropic/claude-haiku-4-5
# Optional. Hard monthly spend cap in EUR. Defaults to 3.00.
# This is the single source of truth: the admin AIUsageCard reads it back from the API.
KYROS_AI_BUDGET_EUR=3.00

# === Public URL (server) ===
# Used to build entry-point QR URLs as <KYROS_PUBLIC_URL>/q/<slug>.
# Under n8n this was hardcoded in the SQL of API_Admin_EntryPoints. Keeping the same domain
# on Vercel means the QR codes already printed keep working: nothing to regenerate.
KYROS_PUBLIC_URL=https://kyros.neuroforge.club

# === Cron protection (server) ===
# Injected by Vercel as `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# Set it locally only to exercise /api/internal/* by hand.
# CRON_SECRET=

# === PWA (Vite, baked in at build time) ===
# Base URL where the QR-code landing pages resolve. Must include the scheme.
# Kept in sync with KYROS_PUBLIC_URL and with stores.settings->>'qr_base_url'.
VITE_QR_BASE_URL=https://kyros.neuroforge.club
# Optional. Overrides the API origin. Leave empty in production: the SPA and the API share
# one origin on Vercel, so relative /api/v1/* is correct.
VITE_API_BASE=

# === Legacy: PostgreSQL admin user (n8n stack only) ===
# Used by database/manage_kyros_db.ps1 against the local Docker Postgres.
# Irrelevant once the migration to Neon is complete.
KYROS_PG_ADMIN_USER=postgres
